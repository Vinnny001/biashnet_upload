PORT=5050

# Cloudinary credentials (from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=dh7srsqbp
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Comma-separated list of origins allowed to call this server
ALLOWED_ORIGINS=http://localhost:3000,https://biashnet.co.ke

# Optional: shared secret the calling backend must send so randoms can't hit this service
UPLOAD_API_KEY=change_this_to_a_long_random_string

# Gemini key for the automatic first-pass listing review (aistudio.google.com/apikey).
# Leave it empty and nothing is checked automatically: every listing stays
# pending and admins are notified, exactly as before this existed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# How many of a listing's photos the check looks at, cover image first.
# Each one costs over a thousand tokens whatever its size.
AI_REVIEW_MAX_IMAGES=4
